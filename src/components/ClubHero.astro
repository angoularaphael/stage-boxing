---
import Photo from './Photo.astro';
import { CLUBS, adresseLigne } from '../data/clubs.js';
import { STAGE, euros } from '../data/stage.js';

interface Props {
  club: 'portet' | 'minimes';
}
const { club } = Astro.props;
const c = CLUBS[club];
---
<section class:list={['hero', `hero--${club}`]} data-hero aria-labelledby="titre-club">
  <Photo name={c.hero} class="hero__img" sizes="100vw" eager decorative />
  <div class="wrap hero__in">
    <p class="eyebrow">{c.bloc}</p>
    <h1 class="hero__titre" id="titre-club">
      <span class="hero__t1 display">Les Vacances des Boxeurs</span>
      <span class="hero__t2">Stage enfants 8–16 ans · {c.court === 'Portet' ? 'Portet-sur-Garonne' : 'Toulouse Minimes'}</span>
    </h1>
    <p class="hero__lede">Stage de boxe anglaise {STAGE.dates}. {STAGE.sousTitre}</p>
    <div class="hero__cta">
      <a class="btn btn--rouge" href={`/inscription?club=${c.id}`} data-cta-inscrire>{c.inscrire} <span class="fleche" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#semaine">Voir le programme</a>
      <span class="puce" data-places={c.id} hidden></span>
    </div>
    <dl class="faits">
      <div class="fait"><dt>Dates</dt><dd>26–31 octobre 2026</dd></div>
      <div class="fait"><dt>Horaires</dt><dd>10h – 12h · 14h – 16h</dd></div>
      <div class="fait"><dt>Lieu</dt><dd>{adresseLigne(c)}</dd></div>
      <div class="fait"><dt>Tarif</dt><dd>{euros(STAGE.prix.adherent)} adhérent · {euros(STAGE.prix.nonAdherent)}</dd></div>
    </dl>
  </div>
</section>
