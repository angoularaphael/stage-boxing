---
/**
 * « Je suis le boxeur / Je suis le parent ». Deux directions pour le même site :
 * le boxeur garde la nuit du gala et le tutoiement ; le parent passe au jour et au vouvoiement,
 * la sécurité et le prix d'abord. Le choix vit dans ce navigateur et voyage dans les liens (?vue=).
 */
interface Props {
  variante?: 'heros' | 'tete' | 'tiroir' | 'pied';
}
const { variante = 'heros' } = Astro.props;
const gant = '<path d="M7.5 9.5V8a4.5 4.5 0 0 1 9 0v6.2a3.8 3.8 0 0 1-3.8 3.8H10a3.2 3.2 0 0 1-3.2-3.2v-2.2M7.5 10.5c-1.6-.4-2.7.6-2.7 1.9 0 1.1.8 2 2 2.1M9 21h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
const famille = '<path d="M8.5 9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm8 2a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM3.8 20c.4-3.4 2.2-5.6 4.7-5.6s4.3 2.2 4.7 5.6M13.6 15.4c.8-.9 1.8-1.4 2.9-1.4 2.2 0 3.6 1.9 3.9 4.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---
<div class:list={['bascule-vue', `bascule-vue--${variante}`]} role="group" aria-label="Je suis" data-bascule-vue>
  {variante === 'heros' && <span class="bascule-vue__je" aria-hidden="true">Je suis</span>}
  <button type="button" class="bascule-vue__choix" data-vue-choix="boxeur" aria-pressed="false" title="Je suis le boxeur">
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={gant} />
    <span>{variante === 'heros' ? 'le boxeur' : 'Boxeur'}</span>
  </button>
  <button type="button" class="bascule-vue__choix" data-vue-choix="parent" aria-pressed="false" title="Je suis le parent">
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={famille} />
    <span>{variante === 'heros' ? 'le parent' : 'Parent'}</span>
  </button>
</div>
