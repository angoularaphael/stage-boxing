---
/**
 * La carte d'un intervenant. Même gabarit que la carte que l'enfant reçoit à la fin de
 * son inscription : il rejoint, littéralement, le paquet de ses coachs.
 */
import { INTERVENANTS, CLUBS } from '../data/clubs.js';
import manifest from '../data/photos.json';

interface Props {
  id: string;
  club: 'portet' | 'minimes';
  delai?: number;
  /** la carte mène à la fiche de l'intervenant (page équipe) */
  lien?: string;
  sizes?: string;
}
const { id, club, delai = 0, lien, sizes = '(min-width: 1000px) 280px, 66vw' } = Astro.props;
const p = INTERVENANTS[id];
const c = CLUBS[club];
const ph = p.photo ? (manifest.coachs as Record<string, any>)[p.photo] : null;
const srcset = ph ? ph.widths.map((w: number) => `/img/coachs/${p.photo}-${w}.webp ${w}w`).join(', ') : '';
const src = ph ? `/img/coachs/${p.photo}-${ph.widths[ph.widths.length - 1]}.webp` : '';
const initiale = p.court.charAt(0);
---
<article
  class:list={['carte', { 'carte--vedette': !!p.vedette }]}
  data-carte
  data-rev="carte"
  style={`--d:${delai}s`}
  aria-label={`${p.nom}, ${p.role}`}
>
  <div class="carte__face">
    {ph ? (
      <img class="carte__photo" srcset={srcset} sizes={sizes} src={src} width="600" height="840" alt={`${p.nom}, ${p.role.toLowerCase()}`} loading="lazy" decoding="async" />
    ) : (
      <span class="carte__mono" aria-hidden="true">{initiale}</span>
    )}
    <div class="carte__haut">
      <span>Les Vacances<br />des Boxeurs</span>
      <span class="carte__club">{c.court}</span>
    </div>
    <div class="carte__bas">
      <span class="carte__role">{p.role}</span>
      <h4 class="carte__nom">{p.nom}</h4>
      {p.vedette && <p class="carte__vedette">{p.vedette}</p>}
      {p.titres.length > 0 && (
        <ul class="carte__titres">
          {p.titres.map((t: string) => <li>{t}</li>)}
        </ul>
      )}
    </div>
    <span class="carte__cadre" aria-hidden="true"></span>
  </div>
  <span class="carte__holo" aria-hidden="true"></span>
  {lien && <a class="carte__lien" href={lien} aria-label={`La fiche de ${p.nom}`}></a>}
</article>
