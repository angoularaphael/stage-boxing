---
/**
 * L'en-tête du site. Chaque lien ouvre une vraie page ; les deux salles portent la couleur
 * de leur lieu. L'en-tête garde son nom de transition : il reste en place quand on change
 * de page, seul le contenu bascule.
 */
import { CLUBS } from '../data/clubs.js';

interface Props {
  club?: 'portet' | 'minimes' | '';
  mode?: 'accueil' | 'club' | 'tunnel' | 'simple';
  actif?: string;
}
const { club = '', mode = 'accueil', actif = '' } = Astro.props;
const c = club ? CLUBS[club] : null;
const ctaHref = c ? `/inscription?club=${c.id}` : '/choisir-mon-club';
const ctaTxt = c ? 'Inscrire mon enfant' : 'Choisir mon club';
const liens = [
  { href: '/stage-enfants-portet', txt: 'Portet', id: 'portet', salle: 'portet' },
  { href: '/stage-enfants-minimes', txt: 'Minimes', id: 'minimes', salle: 'minimes' },
  { href: '/programme', txt: 'Programme', id: 'programme' },
  { href: '/equipe', txt: 'Équipe', id: 'equipe' },
  { href: '/parents', txt: 'Parents', id: 'parents' },
  { href: '/tarifs', txt: 'Tarifs', id: 'tarifs' },
  { href: '/questions', txt: 'Questions', id: 'questions' },
];
---
<header class="hd" data-hd>
  <div class="wrap hd__in">
    <a class="hd__logo" href="/" aria-label="Boxing Center — accueil des stages enfants">
      <img src="/img/logo/bc-logo-400.webp" width="400" height="186" alt="Boxing Center" />
    </a>
    <a class="hd__stage" href="/">Les Vacances des Boxeurs</a>
    {mode !== 'tunnel' && (
      <nav class="hd__nav" aria-label="Navigation principale">
        {liens.map((l) => (
          <a href={l.href} class:list={[l.salle && `hd__salle hd__salle--${l.salle}`]} aria-current={actif === l.id ? 'page' : undefined}>{l.txt}</a>
        ))}
      </nav>
    )}
    {mode === 'tunnel' ? (
      <a class="btn btn--ghost hd__cta" href={c ? c.path : '/'}>Retour au stage</a>
    ) : (
      <a class="btn btn--rouge hd__cta" href={ctaHref} data-cta-hd aria-current={actif === 'choisir' ? 'page' : undefined}>{ctaTxt}</a>
    )}
    {mode !== 'tunnel' && (
      <button class="hd__menu" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="tiroir" data-menu>
        <span></span>
      </button>
    )}
  </div>
</header>
{mode !== 'tunnel' && (
  <div class="tiroir" id="tiroir" role="dialog" aria-modal="true" aria-label="Menu" data-tiroir hidden>
    <div class="tiroir__haut">
      <img src="/img/logo/bc-logo-200.webp" width="200" height="93" alt="Boxing Center" style="width:118px" />
      <button class="tiroir__fermer" type="button" aria-label="Fermer le menu" data-fermer>×</button>
    </div>
    <nav aria-label="Menu mobile">
      {liens.map((l, i) => (
        <a href={l.href} class:list={[l.salle && `hd__salle hd__salle--${l.salle}`]} aria-current={actif === l.id ? 'page' : undefined} style={`--i:${i}`}>
          {l.txt}
        </a>
      ))}
    </nav>
    <div class="tiroir__bas">
      <a class="btn btn--rouge btn--plein" href={ctaHref}>{ctaTxt}</a>
      <p class="tiroir__info">Du lundi 26 au samedi 31 octobre · 8–16 ans</p>
    </div>
  </div>
)}
