---
import Voix from './Voix.astro';
import Partager from './Partager.astro';
---
<section class="sec final" id="final" aria-labelledby="titre-final">
  <div class="wrap final">
    <p class="eyebrow" data-rev>Du lundi 26 au samedi 31 octobre</p>
    <h2 class="final__titre display" id="titre-final" data-rev><Voix p="Réservez<br />sa place" b="Ta place<br />t’attend" html /></h2>
    <div data-rev>
    <div class="final__cta voix voix--p">
      <a class="btn btn--rouge" href="/inscription?club=portet">Inscrire mon enfant à Portet</a>
      <a class="btn btn--rouge" href="/inscription?club=minimes">Inscrire mon enfant aux Minimes</a>
    </div>
    <div class="final__cta voix voix--b">
      <Partager />
      <a class="btn btn--ghost" href="/programme">Voir le programme</a>
    </div>
    </div>
  </div>
</section>
