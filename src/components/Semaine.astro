---
/**
 * La semaine d'un club, créneau par créneau, avec ses coachs et l'objectif de chaque
 * séance. L'horloge est vraie : avant le 26, un compte à rebours ; pendant la semaine,
 * la séance en cours s'allume ; ensuite, la semaine se lit comme une histoire terminée.
 * La couleur monte du lundi au samedi, comme l'intensité.
 */
import { SEMAINE, creneau } from '../data/stage.js';
import { CLUBS, listeNoms } from '../data/clubs.js';
import DonneesAgenda from './DonneesAgenda.astro';

interface Props {
  club: 'portet' | 'minimes';
}
const { club } = Astro.props;
const c = CLUBS[club];
const chaleur = [0.05, 0.22, 0.6, 0.36, 0.52, 1];
---
<section class="sec" id="semaine" aria-labelledby="titre-semaine">
  <div class="wrap">
    <div class="sec__head" data-rev>
      <p class="eyebrow">Le programme {c.a}</p>
      <h2 class="sec__title" id="titre-semaine">La semaine,<br /><em>séance par séance</em></h2>
      <p class="sec__lede">Chaque journée combine apprentissage, mise en pratique et développement des qualités du boxeur.</p>
      <div class="compte" data-compte aria-live="polite" hidden></div>
    </div>
    <div class="semaine" data-semaine>
      {SEMAINE.map((j, i) => (
        <article class="jour" style={`--t:${chaleur[i]}`} data-jour={j.date} data-rev>
          <div class="jour__date">
            <span>{j.jour}</span>
            <b>{j.num}</b>
            <span>octobre</span>
            <span class="puce jour__etat" data-jour-etat hidden></span>
          </div>
          <div class="seances">
            {j.seances.map((s) => {
              const ids = s.coachs[club] || [];
              const titre = s.titreClub ? s.titreClub[club] : s.titre;
              return (
                <div class="seance" data-debut={`${j.date}T${s.debut}`} data-fin={s.fin ? `${j.date}T${s.fin}` : `${j.date}T18:00`}>
                  <div class="seance__h">
                    <time datetime={`${j.date}T${s.debut}`}>{creneau(s)}</time>
                    {s.temps === 'fort' && <span class="temps">Temps fort</span>}
                    {s.temps === 'final' && <span class="temps temps--final">Final de la semaine</span>}
                  </div>
                  <h3>{titre}</h3>
                  {ids.length > 0 && (
                    <p class="seance__coach"><span>{ids.length > 1 ? 'Avec ' : 'Coach : '}</span>{listeNoms(ids, s.temps === 'fort')}</p>
                  )}
                  {s.titre === 'Interclub' && <p class="seance__coach"><span>Lieu et organisation précisés par le club.</span></p>}
                  {/* sur téléphone, le contenu et l'objectif s'ouvrent d'un geste : la semaine tient en deux écrans au lieu de neuf */}
                  <details class="seance__plus">
                    <summary aria-label={`Le contenu de la séance : ${titre}`}><span class="seance__plus-txt">Le contenu de la séance</span></summary>
                    <ul class="seance__contenu">
                      {s.contenu.map((x) => <li>{x}</li>)}
                    </ul>
                    <p class="seance__obj"><b>Objectif :</b> {s.objectif}</p>
                  </details>
                </div>
              );
            })}
          </div>
        </article>
      ))}
    </div>
    {/* sur un grand écran, tout reste ouvert : exécuté avant l'affichage, rien ne bouge */}
    <script is:inline>
      if (matchMedia('(min-width: 900px)').matches) document.querySelectorAll('[data-semaine] .seance__plus').forEach((d) => (d.open = true));
    </script>
    <p class="sec__plus" data-rev>
      <a class="btn btn--ghost" href={`/programme?club=${club}`}>Voir la semaine à l’échelle <span class="fleche" aria-hidden="true">→</span></a>
      <button class="btn btn--ghost" type="button" data-agenda={club}>Ajouter les 12 séances à mon agenda</button>
    </p>
    <p class="agenda__note" data-agenda-note aria-live="polite"></p>
    <DonneesAgenda />
  </div>
</section>
