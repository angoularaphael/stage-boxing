---
/** Infos pratiques d'un club : lieu, repas, matériel (liste à cocher qui se souvient). */
import Sac from './Sac.astro';
import { STAGE } from '../data/stage.js';
import { CLUBS, adresseLigne } from '../data/clubs.js';

interface Props {
  club: 'portet' | 'minimes';
}
const { club } = Astro.props;
const c = CLUBS[club];
const carte = `https://www.google.com/maps/search/?api=1&query=${c.mapsQuery}`;
---
<section class="sec" id="pratique" aria-labelledby="titre-pratique">
  <div class="wrap">
    <div class="sec__head" data-rev>
      <p class="eyebrow">Infos pratiques</p>
      <h2 class="sec__title" id="titre-pratique">Le sac,<br /><em>le lieu, le midi</em></h2>
    </div>
    <div class="pratique">
      <div class="boite" data-rev>
        <h3>Le lieu</h3>
        <p><strong style="color:var(--ink)">{c.nom}</strong><br />{adresseLigne(c)}</p>
        <p>{c.acces}</p>
        <p><a class="lien" href={carte} rel="noopener" target="_blank">Ouvrir l’itinéraire</a></p>
        <p>Une question ? <a class="lien" href={`tel:${c.telHref}`}>{c.tel}</a><br /><a class="lien" href={`mailto:${c.email}`}>{c.email}</a></p>
      </div>
      <div class="boite" data-rev style="--d:.06s">
        <h3>Le midi</h3>
        <p>{STAGE.repas}</p>
        <p>Dans la fiche d’inscription, vous indiquez si votre enfant reste à la salle pendant la pause ou s’il quitte la structure.</p>
      </div>
      <div class="boite" data-rev style="--d:.12s">
        <h3>Préparer le sac</h3>
        <Sac />
      </div>
    </div>
  </div>
</section>
