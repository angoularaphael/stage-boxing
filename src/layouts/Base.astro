---
import '../styles/main.css';
import '../styles/pages.css';
import '../styles/vues.css';
import { SITE_URL } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogAlt?: string;
  page?: string;
  club?: string;
  jsonLd?: object | object[] | null;
  /** images du héros : même srcset/sizes que l'<img>, sinon le téléphone charge deux fichiers */
  preload?: { srcset: string; sizes: string; src: string }[];
}

const {
  title,
  description,
  path = '/',
  robots = 'index, follow, max-image-preview:large',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/img/og/accueil.jpg',
  ogAlt = 'Les Vacances des Boxeurs — stage de boxe enfants Boxing Center, 8–16 ans',
  page = '',
  club = '',
  jsonLd = null,
  preload = [],
} = Astro.props;

const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
const ogUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const graphes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const noindex = robots.includes('noindex');
---
<!doctype html>
<html lang="fr-FR" data-page={page || undefined} data-club={club || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        // arrivée par une transition de page : le héros a déjà bougé avec elle, il ne rejoue pas son entrée
        addEventListener('pagereveal', function (e) {
          if (e.viewTransition) h.classList.add('vt-entree');
        });
        // « Je suis le boxeur / le parent » : posé AVANT le premier affichage (pas de flash), depuis le lien
        // partagé (?vue=) ou le choix déjà fait dans ce navigateur. Le tunnel et l'admin restent neutres.
        if (h.dataset.page === 'inscription' || h.dataset.page === 'admin') return;
        var vue = null;
        try {
          vue = new URLSearchParams(location.search).get('vue');
          if (vue === 'boxeur' || vue === 'parent') localStorage.setItem('vdb-vue', vue);
          else vue = localStorage.getItem('vdb-vue');
        } catch (err) {
          /* navigation privée : pas de mémoire, le site reste neutre */
        }
        if (vue === 'boxeur' || vue === 'parent') h.dataset.vue = vue;
      })();
    </script>
    {!noindex && (
      <script type="speculationrules" is:inline set:html={JSON.stringify({
        prerender: [{
          where: { and: [{ href_matches: '/*' }, { not: { href_matches: ['/inscription*', '/admin*', '/api/*'] } }] },
          eagerness: 'moderate',
        }],
      })} />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="fr-FR" href={canonical} />}
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Boxing Center — Les Vacances des Boxeurs" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="preload" href="/fonts/bebas-neue-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preload.map((p) => <link rel="preload" as="image" href={p.src} imagesrcset={p.srcset} imagesizes={p.sizes} fetchpriority="high" />)}

    {graphes.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="saut" href="#contenu">Aller au contenu</a>
    <slot />
    <script>
      import '../scripts/boot.js';
    </script>
  </body>
</html>
