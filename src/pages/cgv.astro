---
import PageLegale from '../components/PageLegale.astro';
import { DOCUMENTS } from '../data/documents.js';
const cgv = DOCUMENTS.filter((d) => d.id === 'cgv');
---
<PageLegale
  title="Conditions générales de vente — stage enfants Boxing Center"
  description="CGV du stage de boxe enfants Les Vacances des Boxeurs (8–16 ans) : prix, paiement, inscription complète, annulation et données personnelles."
  path="/cgv"
  eyebrow="Les Vacances des Boxeurs"
  titre="Conditions générales de vente"
  docs={cgv}
  ogImage="/img/og/cgv.jpg"
/>
