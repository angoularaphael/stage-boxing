---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<Base
  title="Stage boxe enfants Minimes Toulouse — Les Vacances des Boxeurs"
  description="Stage boxe enfants Minimes Toulouse : Les Vacances des Boxeurs du 26 au 31 octobre 2026, 8-16 ans, encadrement Boxing Center avec Johnson Suffo."
  canonical="https://stages.boxingcenter.fr/stage-enfants-minimes"
  page="club"
  club="minimes"
>
  <div class="wrap">
    <SiteHeader nav="club" club="minimes" />
    <section class="hero">
      <p class="chip"><strong>Minimes — Barriere de Paris</strong> · 12 rue de Fenouillet</p>
      <h1>Les Vacances des Boxeurs</h1>
      <p class="lede">Stage de boxe anglaise du 26 au 31 octobre 2026 — 8 a 16 ans, tous niveaux, filles et garcons.</p>
      <div class="cta-row">
        <a class="btn btn-primary" id="cta-inscrire" href="/inscription?club=minimes">Inscrire mon enfant aux Minimes</a>
        <a class="btn btn-ghost" href="#programme">Voir le programme</a>
      </div>
    </section>

    <section class="section">
      <h2>Tarifs</h2>
      <div class="price-panel">
        <div class="price-display" id="price-value"><span class="currency">EUR</span> 140</div>
        <p class="price-label" id="price-label">Tarif non-adherent</p>
        <label class="member-toggle">
          <input type="checkbox" id="is-member" />
          <span>Je suis adherent Boxing Center (tarif 80 EUR)</span>
        </label>
        <p class="sub">Le tarif comprend 6 jours et 2 seances ou activites par jour. Paiement : CB, PayPal, PayPal Pay Later (si eligibile) ou Scalapay.</p>
        <a class="btn btn-primary" href="/inscription?club=minimes">Reserver la place</a>
      </div>
    </section>

    <section class="section">
      <h2>Equipe Minimes</h2>
      <div class="staff-list">
        <div class="staff"><h3>Mehdi</h3><p>Coach</p></div>
        <div class="staff"><h3>Fayez</h3><p>Coach</p></div>
        <div class="staff"><h3>Lucas</h3><p>Coach</p></div>
        <div class="staff highlight"><h3>Johnson Suffo</h3><p>Boxeur professionnel, top 100 mondial poids moyens</p></div>
      </div>
    </section>

    <section class="section" id="programme">
      <h2>Programme</h2>
      <p class="sub">Meme format que Portet : technique, physique, immersion haut niveau, bowling et interclub. Groupes adaptes selon l'age, le poids, le niveau et l'experience.</p>
      <div class="pillars">
        <div class="pillar"><h3>Technique &amp; Tactique</h3><p>Lecons collectives, deplacements, defense, contre-attaque.</p></div>
        <div class="pillar"><h3>Intensite &amp; Physique</h3><p>Sac, renforcement, coordination, piste, Boot Camp.</p></div>
        <div class="pillar"><h3>Haut Niveau</h3><p>Analyse video, combats tests, intervention Johnson Suffo.</p></div>
        <div class="pillar"><h3>Cohesion</h3><p>Defis collectifs, bowling et interclub.</p></div>
      </div>
    </section>

    <section class="section" id="agenda">
      <h2>Agenda de la semaine</h2>
      <div class="agenda">
        <article class="day">
          <h3>Lundi 26 octobre</h3>
          <p class="slot"><strong>10h–12h</strong> Lecon collective technique — Coach Mehdi</p>
          <p class="slot"><strong>14h–16h</strong> Boot Camp &amp; cohesion — Fayez &amp; Lucas</p>
        </article>
        <article class="day">
          <h3>Mardi 27 octobre</h3>
          <p class="slot"><strong>10h–12h</strong> Lecon collective — Coach Fayez</p>
          <p class="slot"><strong>14h–16h</strong> Assauts a theme + sac — Coach Lucas</p>
        </article>
        <article class="day">
          <h3>Mercredi 28 octobre</h3>
          <p class="slot"><strong>11h–13h</strong> Immersion haut niveau (analyse video) — Johnson Suffo</p>
          <p class="slot"><strong>16h–18h</strong> Combats tests</p>
        </article>
        <article class="day">
          <h3>Jeudi 29 octobre</h3>
          <p class="slot"><strong>10h–12h</strong> Lecon collective technique — Coach Lucas</p>
          <p class="slot"><strong>14h–16h</strong> Seance piste — Coach Mehdi</p>
        </article>
        <article class="day">
          <h3>Vendredi 30 octobre</h3>
          <p class="slot"><strong>10h–12h</strong> Coordination + renforcement — Mehdi &amp; Fayez</p>
          <p class="slot"><strong>14h–16h</strong> Lecon + assauts + sac — Coach Fayez</p>
        </article>
        <article class="day">
          <h3>Samedi 31 octobre</h3>
          <p class="slot"><strong>10h–12h</strong> Bowling — activite cohesion</p>
          <p class="slot"><strong>A partir de 14h</strong> Interclub — Boxing Center Portet</p>
        </article>
      </div>
    </section>

    <section class="section">
      <h2>Infos pratiques</h2>
      <p class="sub">Le repas n'est pas pris en charge. Materiel : gants, protege-dents, casque, tenue de sport, baskets, eau, tenue de rechange.</p>
    </section>

    <footer class="site-footer">
      <p><a href="/">Accueil stages</a> · <a href="/cgv">CGV</a> · <a href="/reglement">Reglement</a></p>
    </footer>
  </div>
  <script>
    import { bootClubPage } from '../scripts/club-page.js';
    bootClubPage();
  </script>
</Base>
