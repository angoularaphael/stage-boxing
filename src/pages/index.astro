---
/**
 * L'accueil : le face-à-face des deux salles (cahier §3), puis une porte vers chaque page
 * du site. Chaque section dit l'essentiel et mène plus loin : la semaine (programme),
 * l'équipe, les parents, le prix, la salle la plus proche, les questions.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FaceOff from '../components/FaceOff.astro';
import Chiffres from '../components/Chiffres.astro';
import SemaineMini from '../components/SemaineMini.astro';
import Piliers from '../components/Piliers.astro';
import Equipes from '../components/Equipes.astro';
import ParentsBref from '../components/ParentsBref.astro';
import Tarif from '../components/Tarif.astro';
import Trouveur from '../components/Trouveur.astro';
import Faq from '../components/Faq.astro';
import Final from '../components/Final.astro';
import Barre from '../components/Barre.astro';
import { STAGE } from '../data/stage.js';
import { FAQ_COURTE } from '../data/faq.js';
import { graphe, organisation, siteWeb, evenement, faq } from '../data/schema.js';
import { precharge } from '../data/precharge.js';

const jsonLd = graphe(organisation(), siteWeb(), evenement('portet'), evenement('minimes'), faq(FAQ_COURTE));
---
<Base
  title="Stage boxe enfants Toulouse — Les Vacances des Boxeurs Boxing Center"
  description="Inscrivez votre enfant au stage Les Vacances des Boxeurs Boxing Center : 6 jours de boxe anglaise, activités, cohésion et encadrement professionnel pour les 8–16 ans à Portet-sur-Garonne et aux Minimes."
  path="/"
  ogTitle="Les Vacances des Boxeurs — stage de boxe enfants 8–16 ans, du 26 au 31 octobre"
  ogDescription="Une semaine 100 % boxe à Portet-sur-Garonne ou aux Minimes : 12 séances, des champions pour encadrer, inscription en ligne."
  ogImage="/img/og/accueil.jpg"
  ogAlt="Les deux salles du stage face à face : Portet-sur-Garonne et les Minimes"
  page="accueil"
  jsonLd={jsonLd}
  preload={[precharge('portet-walkout', '(min-width: 900px) 60vw, 50vw')]}
>
  <SiteHeader mode="accueil" />
  <main id="contenu">
    <FaceOff />
    <Chiffres titre="Une semaine<br /><em>100&#8239;% boxe</em>" intro={`${STAGE.accroche} ${STAGE.public}`}>
      <div class="sem-accueil" data-rev>
        <SemaineMini />
      </div>
      <p class="sec__plus" data-rev>
        <a class="btn btn--ghost" href="/programme">Voir le programme <span class="fleche" aria-hidden="true">→</span></a>
      </p>
    </Chiffres>
    <Piliers club="mix" lien />
    <Equipes plus />
    <ParentsBref />
    <Tarif plus />
    <section class="sec" id="clubs" aria-labelledby="titre-clubs">
      <div class="wrap">
        <div class="sec__head" data-rev>
          <p class="eyebrow">Deux salles, le même stage</p>
          <h2 class="sec__title" id="titre-clubs">La plus proche<br /><em>de chez vous</em></h2>
          <p class="sec__lede">Mêmes dates, mêmes horaires, même programme, mêmes tarifs. Choisissez la salle la plus pratique pour votre famille : les deux groupes se retrouvent le samedi.</p>
        </div>
        <Trouveur compact />
        <p class="sec__plus" data-rev><a class="btn btn--ghost" href="/choisir-mon-club">Comparer les deux salles <span class="fleche" aria-hidden="true">→</span></a></p>
      </div>
    </section>
    <Faq items={FAQ_COURTE} plus />
    <Final />
  </main>
  <SiteFooter />
  <Barre />
</Base>
