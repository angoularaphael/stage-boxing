---
import PageLegale from '../components/PageLegale.astro';
import { DOCUMENTS, DROIT_IMAGE } from '../data/documents.js';
// le règlement d'abord, puis les documents à valider lors de l'inscription
const ordre = ['reglement', 'autorisation', 'sante', 'participation'];
const docs = [
  ...ordre.map((id) => DOCUMENTS.find((d) => d.id === id)).filter(Boolean),
  // le droit à l'image n'est pas un accord obligatoire : on le lit ici, on le choisit dans le tunnel
  {
    id: 'droit-image',
    titre: DROIT_IMAGE.titre,
    sections: [
      {
        p: [
          'Lors de l’inscription, vous choisissez l’une des deux réponses ci-dessous. Les deux sont acceptées : votre choix ne conditionne pas l’inscription de votre enfant.',
          `Oui : « ${DROIT_IMAGE.oui} »`,
          `Non : « ${DROIT_IMAGE.non} »`,
        ],
      },
    ],
  },
];
---
<PageLegale
  title="Règlement intérieur et documents du stage enfants — Boxing Center"
  description="Règlement intérieur du stage Les Vacances des Boxeurs (8–16 ans), autorisation parentale, déclaration sur l’état de santé, pause du midi et droit à l’image."
  path="/reglement"
  eyebrow="Les Vacances des Boxeurs"
  titre="Règlement et documents du stage"
  docs={docs}
  ogImage="/img/og/reglement.jpg"
/>
