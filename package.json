{
  "name": "stage-boxing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Boxing Center — stages enfants Les Vacances des Boxeurs (Portet / Minimes).",
  "scripts": {
    "dev": "node server/dev-api.js --astro",
    "dev:web": "astro dev --port 5620 --host 127.0.0.1",
    "dev:api": "node server/dev-api.js",
    "build": "astro build",
    "preview": "astro preview --port 5620",
    "test": "node --test test/*.test.js",
    "env:make": "node scripts/make-env.mjs",
    "env:push": "node scripts/push-vercel-env.mjs",
    "deploy": "vercel --prod --yes"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "pdfkit": "^0.15.2",
    "sharp": "^0.34.5"
  }
}
