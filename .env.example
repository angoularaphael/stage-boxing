# Site
# Domaine live tant que stages.boxingcenter.fr n'est pas en DNS
# Vercel : https://vercel.com/angoularaphaels-projects (projet stage-boxing)
PUBLIC_URL=https://stage.boxingcenter.fr
SITE_NAME=Stages enfants Boxing Center

# Tarifs (centimes)
PRICE_GUEST_CENTS=14000
PRICE_MEMBER_CENTS=8000

# Places
STOCK_PORTET=40
STOCK_MINIMES=40

# Admin /admin : memes identifiants que BOXPLUS (connexion email + mot de passe)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Cookie session JWT (meme secret que BOXPLUS si possible)
SESSION_SECRET=
# Jeton machine uniquement (scripts / cron) — plus utilise dans l'UI
ADMIN_TOKEN=change-me
# Optionnel : secret cookie studio (sinon = ADMIN_TOKEN)
# STUDIO_COOKIE_SECRET=

# Notifications (Brevo prioritaire — facture PDF jointe apres paiement)
NOTIFY_EMAIL=boxingcenter31@gmail.com
NOTIFY_EMAIL_PORTET=vgsportmanagement@gmail.com
BREVO_API_KEY=
# Meme sender Brevo que BOXPLUS / boutique (stages@boxingcenter.fr n'est pas valide chez Brevo)
MAIL_FROM=Boxing Center Stages <suzinabot@gmail.com>
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center Stages
BREVO_REPLY_TO=boxingcenter31@gmail.com
BREVO_REPLY_TO_PORTET=vgsportmanagement@gmail.com

# Supabase (obligatoire sur Vercel ; en local : data/orders.json)
# Creer la table : supabase/001_stage_orders.sql (SQL Editor Supabase)
# Optionnel pour appliquer en local : DATABASE_URL=postgresql://...
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserve de place pendant le checkout PSP (minutes)
CHECKOUT_RESERVE_MINUTES=30

# Contact affiche dans les e-mails
# STAGE_CONTACT=boxingcenter31@gmail.com

# PayPlug — CB 1x Minimes + Scalapay
PAYPLUG_SECRET_KEY=
# PAYPLUG_TEST_SECRET_KEY=
PAYPLUG_API_VERSION=2019-08-06
# Scalapay Minimes uniquement (0 = off)
PAYPLUG_SCALAPAY_ENABLED=1

# PayPal Minimes
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=

# PayPal Portet (Noble Art Portésien) — Client ID Live complet (>= 60 car.), sinon PayPal n est pas propose
PAYPAL_PORTET_CLIENT_ID=
PAYPAL_PORTET_CLIENT_SECRET=
# PAYPAL_TEST_CLIENT_ID=
# PAYPAL_TEST_CLIENT_SECRET=
# PAYPAL_TEST_PORTET_CLIENT_ID=
# PAYPAL_TEST_PORTET_CLIENT_SECRET=

# CAWL — CB 1x Portet uniquement
CAWL_MERCHANT_ID=
CAWL_API_KEY_ID=
CAWL_API_SECRET=
CAWL_MODE=live
# CAWL_TEST_MERCHANT_ID=
# CAWL_TEST_API_KEY_ID=
# CAWL_TEST_API_SECRET=

# Cron relances
CRON_SECRET=change-me

# Cloudinary — photo enfant sur la carte (meme compte que BOXPLUS si possible)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
